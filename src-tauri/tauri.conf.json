{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turnleaf",
  "version": "1.0.2",
  "identifier": "dev.turnleaf.app",
  "build": {
    "frontendDist": "../src/gui/public",
    "beforeBuildCommand": "npm run stage"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Turnleaf",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false,
        "url": "loading.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/home": "home"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENDUyMDg1RTE3MTc2MkQKUldRdGRuSGhoU0JGUGF1ZzZacnIrU2hsblpzUjNlQkp2djZJM1FBRGlmekQ3Q2poMGJqV25tUkgK",
      "endpoints": ["https://github.com/EmanuelNorsk/turnleaf/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
