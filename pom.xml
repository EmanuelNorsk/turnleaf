<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.turnleaf</groupId>
  <artifactId>turnleaf-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>engine</module>
    <module>shim-runtime</module>
    <module>tests/probe-plugin</module>
  </modules>

  <!--
    Dependency versions below are fallbacks. scripts/fetch-tools.mjs resolves
    the newest stable release of each one and writes them to .mvn/maven.config
    as -D overrides, which Maven applies on every build. Edit the defaults only
    to change what an offline build uses; to pin a version, see fetch-tools.
  -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Turnleaf itself (engine) runs on Java 25+. -->
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Code injected into converted plugins (shim) and the probe fixture stay
         on Java 21 bytecode so converted jars still load on older servers. -->
    <plugin.java.release>21</plugin.java.release>
    <asm.version>9.11.1</asm.version>
    <jackson.version>2.22.4</jackson.version>
    <paper-api.version>26.3.build.218-stable</paper-api.version>
    <folialib.version>0.5.2</folialib.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
